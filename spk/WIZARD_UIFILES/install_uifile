[
  {
    "step_title": "Amintiri",
    "items": [
      {
        "type": "textfield",
        "desc": "The port Amintiri listens on. Point a DSM reverse proxy (HTTPS) at http://localhost:<port>.",
        "subitems": [
          {
            "key": "wizard_port",
            "desc": "Port",
            "defaultValue": "8090",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[1-9][0-9]{3,4}$/",
                "errorText": "A port number, e.g. 8090"
              }
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "Optional. Leave it empty and the Amintiri icon in the DSM main menu opens http://<your NAS>:<port>, which works at home. For use away from home, and for phone backup outside your Wi-Fi, create an HTTPS address in Control Panel → Login Portal → Advanced → Reverse Proxy (your domain, port 443 → http://localhost and the Amintiri port) and enter it here.",
        "subitems": [
          {
            "key": "wizard_url",
            "desc": "Web address (optional)",
            "emptyText": "https://photos.example.com",
            "validator": {
              "allowBlank": true
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "Time zone for photos whose camera didn't record one (IANA name).",
        "subitems": [
          {
            "key": "wizard_tz",
            "desc": "Time zone",
            "defaultValue": "Europe/Bucharest",
            "validator": {
              "allowBlank": false
            }
          }
        ]
      }
    ]
  }
]
